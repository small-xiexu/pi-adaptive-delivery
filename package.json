{
  "name": "pi-adaptive-delivery",
  "version": "0.1.0",
  "description": "Adaptive, approval-gated delivery orchestration for Pi coding tasks",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/small-xiexu/pi-adaptive-delivery.git"
  },
  "homepage": "https://github.com/small-xiexu/pi-adaptive-delivery",
  "bugs": {
    "url": "https://github.com/small-xiexu/pi-adaptive-delivery/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "delivery",
    "subagents"
  ],
  "files": [
    "README.md",
    "docs/技术方案.md",
    "docs/实施计划.md",
    "extensions",
    "prompts",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./extensions/delivery-gate/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx test/support/run-tests.ts test/unit/*.test.ts",
    "test:integration": "node --import tsx test/support/run-tests.ts test/integration/*.test.ts",
    "test:e2e": "node --import tsx test/support/run-tests.ts test/e2e/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "tsx": "4.23.13",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
